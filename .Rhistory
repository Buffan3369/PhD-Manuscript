## New-World ecoregions --------------------------------------------------------
nw <- st_read("../Chapter_1/data_2023/New_World_map_ecoregions/New_World_18_regions_DCsplit.shp")
# switch off the use of s2, otherwise st_union does not work
sf_use_s2(FALSE)
## Elevation -------------------------------------------------------------------
r <- terra::rast("../Chapter_1/data_2023/New_World_map_ecoregions/South_America_topography_Boschman_2021-0_Ma.grd")
r.df <- as.data.frame(r, xy = TRUE)
colnames(r.df) <- c("lon", "lat", "elev")
r.df <- r.df %>% filter(elev >= 0)
library(raster)
## Elevation -------------------------------------------------------------------
r <- raster("../Chapter_1/data_2023/New_World_map_ecoregions/South_America_topography_Boschman_2021-0_Ma.grd")
r.df <- as.data.frame(r, xy = TRUE)
colnames(r.df) <- c("lon", "lat", "elev")
r.df <- r.df %>% filter(elev >= 0)
## Process map data and plot ---------------------------------------------------
nw %>%
# Extract South America
filter(ECO_NAM %in% c("North_Mesoamerica", "Nearctic", "South_Mesoamerica", "Carribean") == F) %>%
# Merge extracted polygons
st_union() %>%
# Plot
ggplot() +
geom_sf(lwd=0) +
geom_tile(data = r.df, aes(x = lon, y = lat, fill = elev)) +
scale_fill_continuous(low = "#fee391", high = "#662506") +
geom_point(data = spl_lonlat, aes(x = lng, y = lat, colour = epoch), size = 2) +
#  scale_color_manual(values = c("#dd3497", "#74a9cf")) +
labs(x = "Longitude", y = "Latitude", fill = "Elevation (m)", colour = NULL) +
theme(panel.grid.major = element_line(linetype = 3, colour = "black", linewidth = 0.1),
panel.grid.minor = element_line(linetype = 3, colour = "black", linewidth = 0.1),
panel.background = element_rect(fill = "#f0f0f0"),
plot.margin=grid::unit(c(0,0,0,0), "mm"))
## Process map data and plot ---------------------------------------------------
PL <- list()
itr <- unique(spl_lonlat$epoch)
itr
itr <- factor(itr, levels = c("Paleocene", "Eocene", "Oligocene", "Miocene", "Pliocene", "Pleistocene", "Holocene"))
itr <- factor(unique(spl_lonlat$epoch),
levels = c("Paleocene", "Eocene", "Oligocene", "Miocene", "Pliocene", "Pleistocene", "Holocene"))
itr
for(i in itr){print(i)}
values(itr)
levels(itr)
library(ggpubr)
for(epch in levels(itr)){
coll <- spl_lonlat %>% filter(epoch == epch)
plt <- nw %>%
# Extract South America
filter(ECO_NAM %in% c("North_Mesoamerica", "Nearctic", "South_Mesoamerica", "Carribean") == F) %>%
# Merge extracted polygons
st_union() %>%
# Plot
ggplot() +
geom_sf(lwd=0) +
geom_tile(data = r.df, aes(x = lon, y = lat, fill = elev)) +
scale_fill_continuous(low = "#fee391", high = "#662506") +
geom_point(data = coll, aes(x = lng, y = lat), size = 2) +
ggtitle(epch) +
labs(x = "Longitude", y = "Latitude", fill = "Elevation (m)", colour = NULL) +
theme(panel.grid.major = element_line(linetype = 3, colour = "black", linewidth = 0.1),
panel.grid.minor = element_line(linetype = 3, colour = "black", linewidth = 0.1),
panel.background = element_rect(fill = "#f0f0f0"),
plot.margin=grid::unit(c(0,0,0,0), "mm"))
PL[[which(levels(itr) == epch)]] <- plt
}
ggarrange(PL, nrow = 2)
ggarrange(plotlist = PL, nrow = 2)
ggarrange(plotlist = PL, ncol = 4, nrow = 2)
