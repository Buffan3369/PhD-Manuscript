x <- seq(0, 10, 1000)
alph <- -2
# Older species have a higher extinction probability
y_ade <- sapply(X = x, FUN = function(x){x**alph})
# Red Queen (age-independence)
y_RQ <- sapply(X = x, FUN = function(x){alph*x})
plot(x = x, y = log(y_ade), type = 'l')
