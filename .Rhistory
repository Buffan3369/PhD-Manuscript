y_RQ <- sapply(X = t, FUN = function(x){exp(alph2*x)})
df <- data.frame(time = rep(t, 2),
y = c(y_ade1, y_ade2, y_RQ),
lab = c(rep("ADE1", length(t)),
rep("ADE1", length(t)),
rep("Req Queen", length(t))))
library(tidyverse)
t <- seq(from = 0.01, to = 50, by = 0.01)
alph1 <- 2
alph2 <- 0.2
# Older species have a higher extinction probability
y_ade1 <- sapply(X = t, FUN = function(x){x**alph1})
# Younger species have a higher extinction probability
y_ade2 <- sapply(X = t, FUN = function(x){x**(-alph1)})
# Red Queen (age-independence)
y_RQ <- sapply(X = t, FUN = function(x){exp(alph2*x)})
df <- data.frame(time = rep(t, 2),
y = c(y_ade1, y_ade2, y_RQ),
lab = c(rep("ADE1", length(t)),
rep("ADE1", length(t)),
rep("Req Queen", length(t))))
df <- data.frame(time = rep(t, 3),
y = c(y_ade1, y_ade2, y_RQ),
lab = c(rep("ADE1", length(t)),
rep("ADE1", length(t)),
rep("Req Queen", length(t))))
df %>% ggplot(aes(x = time, y = y)) +
geom_line(aes(colour = lab)) +
scale_x_reverse() +
scale_y_log10() +
scale_color_manual(values = c("#034e7b", "#ce1256", "green"))
View(df)
