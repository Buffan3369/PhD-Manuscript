geom_segment(aes(x = 66, xend = 66, y = 4600, yend = 4000),
arrow = arrow(type = "closed", length = unit(0.3, "cm"))) +
annotate(geom = "text", fontface = 2, label = "5. Cretaceous−\nPalaeogene", x = 66, y = 4850)
